# Copy this file to .env.local and replace the dummy values with the real ones.
# .env.local is git-ignored. Never commit real credentials.
# Restart the dev server after changing these.
#
# The dummy values below are an example for Brevo (https://www.brevo.com).
# Any SMTP provider works: change the host, port, login and key to match it.

# --- SMTP account used to send email (required) ---

# SMTP server.
# Brevo: smtp-relay.brevo.com
SMTP_HOST=smtp-relay.brevo.com

# 587 (STARTTLS) is the usual choice. Other options: 465 (SSL/TLS), 2525 (if 587 is blocked).
SMTP_PORT=587

# SMTP login.
# Brevo: Profile menu > SMTP & API > SMTP tab > "Login". It ends in @smtp-brevo.com
# and is NOT your own email address.
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com

# SMTP password.
# Brevo: the "SMTP key" you generate on the same page (starts with xsmtpsib-).
# It is NOT your account or mailbox password. Shown only once, so copy it straight away.
SMTP_PASS=paste-your-brevo-smtp-key-here

# --- Dealer lead emails ---

# Inbox that receives the "Become a Dealer" leads.
# If left out, leads go to the company address in src/constant/siteData.ts.
LEAD_TO_EMAIL=contact@yourcompany.com

# "From" shown on the lead email. If left out, the company address is used.
# Brevo: this address must be added and verified under
# Senders, Domains & Dedicated IPs > Senders (and ideally the domain authenticated).
# Keep the quotes: the value contains spaces and < >.
SMTP_FROM="Your Company Website <contact@yourcompany.com>"
